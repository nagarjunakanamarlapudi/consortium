#!/usr/bin/env python3
"""Stdlib-only guard shared by the three executable PATH shims."""

import json
import os
from pathlib import Path
import re
import shlex
import shutil
import sys


def glob_match(value, pattern):
    # Same path-glob grammar as config.glob_match; these executables must also
    # run under a plain system Python without the command's PyYAML dependency.
    pieces = []
    index = 0
    while index < len(pattern):
        if pattern.startswith("**/", index):
            pieces.append("(?:.*/)?")
            index += 3
        elif pattern.startswith("**", index):
            pieces.append(".*")
            index += 2
        elif pattern[index] == "*":
            pieces.append("[^/]*")
            index += 1
        else:
            pieces.append(re.escape(pattern[index]))
            index += 1
    return re.fullmatch("".join(pieces), value) is not None


def command_args(name, args):
    """Remove global options so deny rules still see the real subcommand."""
    takes_value = ({"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env",
                    "--super-prefix", "--attr-source"} if name == "git" else
                   {"-R", "--repo", "--hostname"})
    index = 0
    while index < len(args) and args[index].startswith("-"):
        option = args[index]
        index += 1
        if option == "--":
            break
        if option in takes_value and index < len(args):
            index += 1
    return args[index:]


def make_targets(args):
    takes_value = {"-C", "--directory", "-f", "--file", "--makefile", "-I", "--include-dir",
                   "-o", "--old-file", "--assume-old", "-W", "--what-if", "--new-file", "--assume-new",
                   "--eval"}
    index = 0
    options = True
    while index < len(args):
        arg = args[index]
        index += 1
        if options and arg == "--":
            options = False
        elif options and arg in takes_value:
            index += 1
        elif options and arg in {"-j", "--jobs", "-l", "--load-average", "--max-load"}:
            if index < len(args) and re.fullmatch(r"\d+(?:\.\d+)?", args[index]):
                index += 1
        elif options and arg.startswith("-"):
            continue
        elif "=" not in arg:
            yield arg


def main():
    name = globals().get("COMMAND", Path(sys.argv[0]).name)
    args = sys.argv[1:]
    command = shlex.join([name, *args])
    try:
        guard = json.loads(os.environ.get("CONSORTIUM_GUARD", "{}"))
        candidates = [command, " ".join([name, *(re.sub(r"\s", "_", arg) for arg in args)])]
        if name in {"git", "gh"}:
            candidates.append(shlex.join([name, *command_args(name, args)]))
        denied = any(re.search(pattern, candidate) for pattern in guard.get("deny", []) for candidate in candidates)
        if name == "make":
            denied = denied or any(glob_match(target, pattern) for target in make_targets(args)
                                   for pattern in guard.get("deny_make", []))
    except (ValueError, TypeError, AttributeError, re.error):
        denied = True
    if denied:
        print(f"consortium: {command} is not allowed inside an agent run; the manager commits, pushes and deploys",
              file=sys.stderr)
        return 126
    own = Path(__file__).resolve().parent
    entries = os.environ.get("PATH", "").split(os.pathsep)
    positions = [index for index, entry in enumerate(entries) if Path(entry or ".").resolve() == own]
    after = entries[positions[0] + 1:] if positions else entries
    after = [entry for entry in after if Path(entry or ".").resolve() != own]
    binary = shutil.which(name, path=os.pathsep.join(after))
    if binary is None:
        print(f"consortium: no real {name} found after the guard shim on PATH", file=sys.stderr)
        return 127
    os.execv(binary, [binary, *args])


if __name__ == "__main__":
    sys.exit(main())
